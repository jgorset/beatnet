{
  "name": "@jgorset/beatnet",
  "version": "1.0.0",
  "description": "BeatNet beat and downbeat tracking in the browser.",
  "type": "module",
  "license": "MIT",
  "author": "Johannes Gorset",
  "repository": { "type": "git", "url": "https://github.com/jgorset/beatnet.git" },
  "bugs": { "url": "https://github.com/jgorset/beatnet/issues" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
